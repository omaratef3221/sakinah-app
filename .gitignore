# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated files
*.g.dart
*.freezed.dart
*.mocks.dart

# Coverage
coverage/

# Drift database files (optional - uncomment if you don't want to track local DB)
# *.sqlite
# *.sqlite-shm
# *.sqlite-wal

# App signing keys (NEVER commit these!)
android/key.properties
android/*.jks
*.jks
*.keystore
*.p8
AuthKey_*.p8

# Firebase config (contains API keys — generated by `flutterfire configure`)
# These are technically safe to commit (they're scoped by bundle ID + Firebase
# security rules), but keeping them out of source control is a good default.
# Uncomment if you prefer to ignore them:
# lib/firebase_options.dart
# ios/Runner/GoogleService-Info.plist
# android/app/google-services.json
